#include<stdio.h>

int main()
{
    int row,column;

    printf("Enter the row of the matrix: ");
    scanf("%d",&row);

    printf("Enter the column of the matrix: ");
    scanf("%d",&column);

    int matrix1[row][column];
    int matrix2[row][column];
    int product[row][column];
    printf("matrix1\n");
    for(int i=0;i<row;i++)
        {
            printf("for the row %d\n",i+1);
            for(int k=0;k<column;k++)
            {
                printf("Enter value for column %d: ",k+1);
                scanf("%d",&matrix1[i][k]);
            }
            printf("\n");
        }
        printf("matrix2\n");
        for(int k=0;k<row;k++)
        {
            printf("for the row %d\n",k+1);
            for(int j=0;j<column;j++)
            {
                printf("Enter value for column %d: ",j+1);
                scanf("%d",&matrix2[k][j]);
            }
            printf("\n");
        }
        for (int i = 0; i < row; ++i) {
        for (int j = 0; j < column; ++j) {
            for (int k = 0; k < column; ++k) {
                product[i][j] += matrix1[i][k] * matrix2[k][j];
            }
        }
    }
    return 0;
}
